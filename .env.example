# Шаблон переменных окружения. Значения сюда НЕ вписываются.
#
# Продакшен: Vercel → Project → Settings → Environment Variables
# (окружения Production и Preview). Файл .env в репозиторий не коммитится —
# он в .gitignore.

# --- Доставка заявок (обязательно, работают только в паре) -------------------
# Токен бота от @BotFather. Секрет: без префикса VITE_, иначе Vite вшил бы
# его в публичный бандл.
TELEGRAM_BOT_TOKEN=
# id чата или группы, куда падают заявки. Получателей может быть несколько —
# перечислите их через запятую: TELEGRAM_CHAT_ID=670030360,-1001234567890
# Заявка уйдёт каждому. Свой id можно узнать у @userinfobot; каждый получатель
# должен один раз нажать /start в боте, иначе Telegram откажет с «chat not found».
TELEGRAM_CHAT_ID=

# --- Необязательно ----------------------------------------------------------
# Альтернатива Telegram: заявка уходит POST-запросом на любой URL (CRM, Make, n8n).
# LEAD_WEBHOOK_URL=

# Канонический домен для canonical, OG-тегов и sitemap.
# Без него берётся https://digital-modus-operandi.vercel.app
# VITE_SITE_URL=

# Аналитика на старте не подключается — см. DMO_REWORK_PROGRESS.md §5.11.
# Слой событий провайдер-независим и переменных не требует.
